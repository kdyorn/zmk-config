#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define FN   1
#define NUM  2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = 

&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6
&kp TAB  &kp Q   &kp W   &kp E   &kp R   &kp T
&kp CAPS &kp A   &kp S   &kp D   &kp F   &kp G
&kp LSFT &kp Z   &kp X   &kp C   &kp V   &kp B
&kp LCTL &kp LGUI &kp LALT &mo FN  &kp SPACE

&kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS &kp EQUAL &kp BSPC &kp DEL
&kp Y   &kp U   &kp I   &kp O   &kp P     &kp LBKT  &kp RBKT &kp BSLH &kp C_AL_CALC
&kp H   &kp J   &kp K   &kp L   &kp SEMI  &kp SQT             &kp RET  &kp PG_UP
&kp N   &kp M   &kp COMMA &kp DOT &kp FSLH           &kp RSFT &kp UP   &kp PG_DN
        &kp SPACE        &kp RALT &kp RCTL &mo FN    &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        fn_layer {
            label = "FN";
            bindings = 
/* Left Hand */
&bootloader &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans

/* Right Hand */
&kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &kp F12 &trans &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans
        &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = 
/* Left Hand */
&trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans

/* Right Hand */
&trans  &kp N7  &kp N8  &kp N9  &trans  &trans  &trans  &trans
&trans  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &trans  &trans          &trans  &trans
&trans  &kp N0  &trans  &trans  &trans          &trans  &trans  &trans
        &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};