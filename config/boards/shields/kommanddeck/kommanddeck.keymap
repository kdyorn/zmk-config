#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        revit_dv: revit_dv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp V>;
        };
        revit_mc: revit_mc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp C>;
        };
        revit_ci: revit_ci {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I>;
        };
        revit_cc: revit_cc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp C>;
        };
        revit_cs: revit_cs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp S>;
        };
        revit_dm: revit_dm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp M>;
        };
        revit_al: revit_al {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp L>;
        };
        revit_di: revit_di {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp I>;
        };
        revit_rp: revit_rp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp P>;
        };
        revit_dg: revit_dg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp G>;
        };
        revit_mv: revit_mv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp V>;
        };
        revit_el: revit_el {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp L>;
        };
        revit_eh: revit_eh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp H>;
        };
        revit_eu: revit_eu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp U>;
        };
        revit_hr: revit_hr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp R>;
        };
        revit_ic: revit_ic {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp C>;
        };
        revit_rh: revit_rh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp H>;
        };
        revit_hi: revit_hi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp I>;
        };
        revit_dl: revit_dl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp L>;
        };
        revit_tl: revit_tl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp L>;
        };
        revit_tx: revit_tx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp X>;
        };
        revit_tg: revit_tg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp G>;
        };
        revit_rv: revit_rv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp V>;
        };
        revit_s2: revit_s2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp N2>;
        };
        revit_mb: revit_mb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp B>;
        };
        revit_bx: revit_bx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp X>;
        };
        revit_vv: revit_vv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp V>;
        };
        revit_ds: revit_ds {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N4)>;
        };
        /* NEW macros: copy a node above, rename it, then swap the &none in the layer */
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "REVIT";
            bindings = <
/* r0 */ &kp ESC     &revit_dv   &revit_mc   &revit_ci   &revit_cc   &revit_cs   &kp DEL    &kp LC(Z)    &kp LC(X)       &kp LC(C)   &kp LC(V)
/* r1 */ &revit_dm      &revit_al   &revit_di   &revit_rp    &revit_dg   &revit_mv   &revit_el     &none        &kp KP_DIVIDE   &kp KP_MULTIPLY &kp KP_MINUS
/* r2 */ &kp TAB     &revit_eh   &revit_eu   &revit_hr    &revit_ic   &revit_rh   &revit_hi     &kp KP_N7    &kp KP_N8       &kp KP_N9
/* r3 */ &kp RET     &revit_dl   &revit_tl   &revit_tx    &revit_tg   &revit_rv   &kp PG_UP  &kp KP_N4    &kp KP_N5       &kp KP_N6   &kp KP_PLUS
/* r4 */ &kp LSHIFT  &revit_s2   &revit_mb   &revit_ds &revit_bx   &revit_vv   &kp PG_DN  &kp KP_N1    &kp KP_N2       &kp KP_N3
/* r5 */ &kp LCTRL   &kp LALT &none    &none     &kp SPACE                      &kp KP_N0    &kp KP_DOT      &kp KP_ENTER
            >;
        };
    };
};
